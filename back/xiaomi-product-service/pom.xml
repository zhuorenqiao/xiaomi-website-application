<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.xiaomi</groupId>
    <artifactId>xiaomi-backend</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>xiaomi-product-service</artifactId>
  <name>xiaomi-product-service</name>
  <description>小米商品服务：基于 MySQL 商品库对外提供首页商品栏目（GET /api/products/sections）与关键词分页搜索（GET /api/products/search）</description>

  <dependencies>
    <dependency>
      <groupId>com.xiaomi</groupId>
      <artifactId>xiaomi-product-api</artifactId>
    </dependency>
    <!-- Spring Boot 4 起 starter-web 改名为 starter-webmvc（旧名已废弃） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- 商品列表落到 MySQL：用 MyBatis 写 SQL（动态条件与分页在 mapper XML 里维护），
         starter 自带 spring-boot-starter-jdbc（数据源 / 事务） -->
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
