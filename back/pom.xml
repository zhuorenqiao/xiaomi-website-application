<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.xiaomi</groupId>
  <artifactId>xiaomi-backend</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>xiaomi-backend</name>
  <description>小米后端父工程：按业务域拆分模块，每个可运行模块可独立演进为微服务</description>

  <modules>
    <module>xiaomi-chat-api</module>
    <module>xiaomi-chat-service</module>
    <module>xiaomi-product-api</module>
    <module>xiaomi-product-service</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <xiaomi-backend.version>1.0.0</xiaomi-backend.version>
    <!-- MyBatis 官方 starter 的 4.x 线对应 Spring Boot 4（内部依赖 mybatis 3.5.19 + mybatis-spring 4.1.0） -->
    <mybatis-spring-boot.version>4.1.0</mybatis-spring-boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- 站内各服务契约模块：其他服务接入时直接依赖对应 api，无需关心版本 -->
      <dependency>
        <groupId>com.xiaomi</groupId>
        <artifactId>xiaomi-chat-api</artifactId>
        <version>${xiaomi-backend.version}</version>
      </dependency>
      <dependency>
        <groupId>com.xiaomi</groupId>
        <artifactId>xiaomi-product-api</artifactId>
        <version>${xiaomi-backend.version}</version>
      </dependency>
      <!-- 第三方 starter 版本统一在此锁定（Spring Boot 父 pom 未收录 MyBatis） -->
      <dependency>
        <groupId>org.mybatis.spring.boot</groupId>
        <artifactId>mybatis-spring-boot-starter</artifactId>
        <version>${mybatis-spring-boot.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
